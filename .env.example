# Approved-public-content service copied from the Michigan Intel Desk pattern.
# The adapter tries /api/wire/packets first, then /api/tracker-feed.json.
FLORIDA_SIGNAL_CMS_URL=http://127.0.0.1:8787
FLORIDA_SIGNAL_CMS_TOKEN=

# Broward Audience in the connected Mailchimp account.
# Keep the API key server-side; never place it in app.js or any public HTML.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us2
MAILCHIMP_AUDIENCE_ID=123540d751
MAILCHIMP_ZIP_MERGE_TAG=WATCHZIP

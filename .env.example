# Approved-public-content service copied from the Michigan Intel Desk pattern.
# The adapter tries /api/wire/packets first, then /api/tracker-feed.json.
FLORIDA_SIGNAL_CMS_URL=http://127.0.0.1:8787
FLORIDA_SIGNAL_CMS_TOKEN=
FLORIDA_SIGNAL_CMS_MARKET=broward
FLORIDA_SIGNAL_CMS_CITY=fort-lauderdale
FLORIDA_SIGNAL_STORM_MODE=
FLORIDA_SIGNAL_DB_PATH=
FLORIDA_SIGNAL_PUBLIC_ORIGINS=https://thefloridasignal.com,https://www.thefloridasignal.com

# Public read-only mirror used by the data-health endpoint. Keep the service-role
# key private; this value must remain a publishable/anon key protected by RLS.
FLORIDA_SIGNAL_SUPABASE_URL=
FLORIDA_SIGNAL_SUPABASE_PUBLISHABLE_KEY=

# Private multi-market editorial desk. Run cms/server.py separately; never expose
# this token in public HTML or browser JavaScript.
DATA_WIRE_ADMIN_TOKEN=
DATA_WIRE_DB_PATH=

# Broward Audience in the connected Mailchimp account.
# Keep the API key server-side; never place it in app.js or any public HTML.
# systemd EnvironmentFile syntax is NAME=value; do not prefix assignments with export.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us2
MAILCHIMP_AUDIENCE_ID=123540d751
MAILCHIMP_ZIP_MERGE_TAG=WATCHZIP
# Optional Mailchimp text merge field for comma-separated city interests.
MAILCHIMP_CITIES_MERGE_TAG=
# Optional Mailchimp text merge field for comma-separated topic interests.
MAILCHIMP_INTERESTS_MERGE_TAG=

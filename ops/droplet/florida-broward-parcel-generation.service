[Unit]
Description=Florida Signal - immutable Broward current parcel generation
Documentation=file:/srv/grahamandgold/florida-signal/app/BROWARD_PARCEL_GENERATION_RUNBOOK.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/florida-signal/enable-broward-parcel-generation
OnFailure=florida-freshness-alert.service

[Service]
Type=oneshot
User=andy
Group=andy
WorkingDirectory=/srv/grahamandgold/florida-signal/app
EnvironmentFile=/srv/grahamandgold/florida-signal/secrets/.env
RuntimeDirectory=florida-signal
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --nonblock /run/florida-signal/broward-parcel-generation.lock /usr/bin/python3 /srv/grahamandgold/florida-signal/app/ops/droplet/broward_parcel_generation.py --allow-network --mode current-generation --write-supabase --evidence-root /var/lib/florida-signal/broward-parcel-generations
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/florida-signal/broward-parcel-generations
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0027
TimeoutStartSec=10800
Restart=no

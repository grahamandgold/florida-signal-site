# This package is deliberately inert until both the schema and service have
# been reviewed on the production host. Keep the collection gate at 0 until a
# separately approved natural-run observation window begins.
FLORIDA_SIGNAL_SFWMD_ENABLED=0

# The product mirror is an independent gate. Leave it at 0 until the private
# migration is applied and a local natural run has been reconciled.
FLORIDA_SIGNAL_SFWMD_MIRROR_ENABLED=0

# Secrets belong only in the host-owned EnvironmentFile. Never commit values.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SET_ON_HOST_ONLY
